# Maintainer: Hugo Maitre <hugo.maitre69@gmail.com>
pkgname=laptop-tune
pkgver=2.8.0
pkgrel=1
pkgdesc="Unified Linux laptop auditor and configurator for hybrid GPU PM, CPU profiles, thermals, and battery thresholds"
arch=('x86_64' 'aarch64')
url="https://github.com/HmFlashy/laptop-tune"
license=('MIT')
depends=('gcc-libs' 'glibc' 'hicolor-icon-theme' 'polkit')
makedepends=('cargo')
install=laptop-tune.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')" || true
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --release
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo test
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 "packaging/$pkgname.desktop" "$pkgdir/usr/share/applications/$pkgname.desktop"
  install -Dm644 "packaging/$pkgname.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/$pkgname.svg"
  install -Dm644 "packaging/org.laptop-tune.policy" "$pkgdir/usr/share/polkit-1/actions/org.laptop-tune.policy"
  install -Dm644 "packaging/$pkgname.service" "$pkgdir/usr/lib/systemd/system/$pkgname.service"
  install -Dm644 "packaging/99-laptop-tune-override.conf" "$pkgdir/etc/tlp.d/99-laptop-tune-override.conf"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
