post_install() {
  if [ -x /usr/bin/laptop-tune ]; then
    /usr/bin/laptop-tune setup-gpu || true
    udevadm control --reload-rules 2>/dev/null || true
    udevadm trigger --subsystem-match=pci --subsystem-match=drm 2>/dev/null || true
  fi
  pkill -f "laptop-tune gui" 2>/dev/null || true
}

post_upgrade() {
  post_install
}

post_remove() {
  rm -f /etc/udev/rules.d/90-laptop-tune-gpu.rules /etc/modprobe.d/90-laptop-tune-gpu.conf /etc/environment.d/90-laptop-tune-igpu.conf
  udevadm control --reload-rules 2>/dev/null || true
}
